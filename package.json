{
  "name": "quiz-my-pdf",
  "version": "0.25.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    }
  },
  "license": "MIT",
  "author": {
    "name": "Mouaz Aldakkak",
    "url": "https://maldakkak.de"
  },
  "scripts": {
    "build": "vite build",
    "check": "biome check",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf .next .nitro .output dist && rm -rf node_modules",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "drizzle-kit migrate --config drizzle.migrate.config.ts",
    "db:pull": "drizzle-kit pull",
    "db:push": "drizzle-kit push",
    "dev": "vite dev",
    "format": "biome format --write",
    "lint": "biome lint --write --unsafe",
    "lint:format": "biome check --write",
    "release": "semantic-release # release plugins (e.g. @semantic-release/git) configured in .releaserc.json",
    "start": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "e2e run",
    "e2e:seed": "node scripts/e2e-seed-user.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "3.0.131",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-start": "1.168.61",
    "@trpc/client": "11.19.0",
    "@trpc/react-query": "11.19.0",
    "@trpc/server": "11.19.0",
    "@vitejs/plugin-react": "6.1.2",
    "ai": "7.0.137",
    "better-auth": "1.7.7",
    "canvas-confetti": "1.9.4",
    "daisyui": "5.7.16",
    "dayjs": "1.11.23",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "gsap": "3.15.0",
    "lucide-react": "1.30.0",
    "nitro": "3.0.260903-beta",
    "pg": "8.23.1",
    "postcss": "8.5.28",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.17.7",
    "unpdf": "1.8.1",
    "vite": "8.3.4",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@acai.sh/cli": "0.0.4",
    "@ai-sdk/openai": "4.0.91",
    "@biomejs/biome": "2.5.15",
    "@e2e-dev/github": "0.4.0",
    "@e2e-dev/web": "0.14.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.3",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.1",
    "dotenv": "18.0.3",
    "e2e": "0.19.0",
    "jsdom": "30.1.1",
    "msw": "2.15.0",
    "playwright": "1.64.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "browserslist": "> 1%"
}
